# Copia este archivo a .env.local y completa los valores.

# Firebase Admin SDK (opcional, solo si usas firebase/admin)
# ej.: FIREBASE_ADMIN_SDK={"type":"service_account","project_id":"...",...}
FIREBASE_ADMIN_SDK=

# Google Maps (usado en app/[locale]/(main)/map)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Resend (envío de correos transaccionales)
# Obtén tu API key en https://resend.com/api-keys
# El dominio "antilabs.com.mx" debe estar verificado en Resend antes de poder enviar desde él.
RESEND_API_KEY=
RESEND_FROM_EMAIL="RUBS Vivo <rubs@antilabs.com.mx>"
